# LLM provider: openai (default), grok, or openrouter
LLM_PROVIDER=openai

# OpenAI — required when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model id
OPENAI_MODEL=gpt-4o

# Grok (xAI) — required when LLM_PROVIDER=grok
# Create the key at https://console.x.ai/ (API Keys). GROK_API_KEY is an accepted alias for XAI_API_KEY.
XAI_API_KEY=your_grok_key_here

# Optional: Grok model id (xAI flagship as of the docs dated 2026-10)
GROK_MODEL=grok-4.7

# OpenRouter — required when LLM_PROVIDER=openrouter
# Create the key at https://openrouter.ai/keys. Model ids are provider/model.
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: OpenRouter model id
OPENROUTER_MODEL=openai/gpt-4o

# AAMAD runtime target (default for this course)
AAMAD_TARGET_RUNTIME=crewai

# Application Configuration
APP_NAME=Recruitment Assistant
APP_ENV=development

# CrewAI anonymous library telemetry. Independent of execution traces below.
CREWAI_TELEMETRY_OPT_OUT=true

# Execution traces for the Application Crew. The crew is built with tracing=True
# unless this is false. After `crewai login`, restart and open the "View traces" link.
# Traces include requisition and candidate text and are sent to CrewAI AMP.
CREWAI_TRACING_ENABLED=true

# recruitment logger threshold for stdout and trace.log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Web search (required to kick off a run; no secret value in this file)
SERPER_API_KEY=

# Optional runtime controls
CANDIDATE_LIMIT=10
HOST=127.0.0.1
PORT=8000
